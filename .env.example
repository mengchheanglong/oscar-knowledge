KNOWLEDGE_DATABASE_URL=postgresql+psycopg://knowledge:local_knowledge_only@127.0.0.1:43114/knowledge
KNOWLEDGE_SERVICE_TOKEN=
# Separate backend-only HMAC key; never reuse the bearer service token.
KNOWLEDGE_PRIVATE_SCOPE_SECRET=
# Optional absolute local JSON manifest of exact book/owner/reader/collection grants.
# Empty preserves owner-only private access. Never expose this file through HTTP.
KNOWLEDGE_PRIVATE_READER_GRANTS_PATH=
KNOWLEDGE_ALLOWED_COLLECTIONS=["mba-business"]
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_EMBEDDING_PROVIDER=disabled
KNOWLEDGE_EMBEDDING_BASE_URL=https://api.openai.com/v1
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
# Local Qwen: set provider=ollama, model=qwen3-embedding:0.6b, dimensions=1024.
# Pin the full digest from `ollama list` / GET /api/tags after pulling the model.
KNOWLEDGE_EMBEDDING_MODEL_REVISION=
KNOWLEDGE_OLLAMA_BASE_URL=http://127.0.0.1:11434
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=15
KNOWLEDGE_EMBEDDING_QUERY_TIMEOUT_SECONDS=2
KNOWLEDGE_EMBEDDING_DOCUMENT_TIMEOUT_SECONDS=600
KNOWLEDGE_EMBEDDING_MAX_DOCUMENT_CHUNKS=256
KNOWLEDGE_OLLAMA_KEEP_ALIVE=10m
KNOWLEDGE_OLLAMA_QUERY_INSTRUCTION=Given a question, retrieve relevant passages that answer the question

# Optional UUID list for source-bound quality exclusions; does not delete stored evidence.
KNOWLEDGE_QUALITY_EXCLUDED_CHUNK_IDS=[]

# Bounded per-statement SQL budget; large local libraries may need 10000.
KNOWLEDGE_DATABASE_STATEMENT_TIMEOUT_MS=5000
